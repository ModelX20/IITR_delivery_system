generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is the Linux used by Vercel Functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  DELIVERY_PARTNER
  ADMIN
}

/// Delivery partner application state. Null for users who never signed up as a partner.
enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  // Optional so a first-time Google user can exist before completing their profile.
  enrollmentNo        String?              @unique
  phone               String?
  bhawan              String?
  // Null for Google-only accounts that have never set a password.
  passwordHash        String?
  googleId            String?              @unique
  // Embedded in session tokens; bumping it logs out every existing session.
  tokenVersion        Int                  @default(0)
  role                Role                 @default(STUDENT)
  // Delivery partners can only deliver once an admin has approved them.
  partnerStatus       PartnerStatus?
  isBlocked           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  cartItems           CartItem[]
  orders              Order[]              @relation("Customer")
  statusChanges       OrderStatusHistory[]
  passwordResetTokens PasswordResetToken[]
  deliveries          Order[]              @relation("DeliveryPartner")

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // SHA-256 of the token. The raw token only ever exists in the emailed link.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Item {
  id          String      @id @default(cuid())
  name        String
  description String
  category    String
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String
  stock       Int
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([category])
}

model CartItem {
  id       String @id @default(cuid())
  userId   String
  itemId   String
  quantity Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Order {
  id                String               @id @default(cuid())
  userId            String
  status            OrderStatus          @default(PLACED)
  subtotal          Decimal              @db.Decimal(10, 2)
  deliveryFee       Decimal              @db.Decimal(10, 2)
  total             Decimal              @db.Decimal(10, 2)
  bhawan            String
  roomNo            String
  note              String?
  createdAt         DateTime             @default(now())
  user              User                 @relation(fields: [userId], references: [id], name: "Customer")
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  // Set when a delivery partner accepts the order; from then on only they can see and deliver it.
  deliveryPartnerId String?
  deliveryPartner   User?                @relation("DeliveryPartner", fields: [deliveryPartnerId], references: [id])
  acceptedAt        DateTime?

  @@index([userId, createdAt])
  @@index([deliveryPartnerId, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([bhawan])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  itemId    String
  itemName  String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      Item    @relation(fields: [itemId], references: [id])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  changedById String
  changedAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id])

  @@index([orderId, changedAt])
}

// Store-wide settings. Always a single row with id = 1.
model StoreSettings {
  id                Int @id @default(1)
  lowStockThreshold Int @default(5)
}
