# Copy this file to .env and adjust as needed.

PORT=4000
NODE_ENV=development

# Postgres (matches both `npm run db` and docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iitr_delivery
# Separate database used by `npm test` (wiped on every test run)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iitr_delivery_test

# Use a long random string in real deployments, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Passwords for the seeded demo accounts (used only by `npx prisma db seed`)
# Students test@iitr.ac.in and riya@iitr.ac.in
SEED_TEST_PASSWORD=Test@1234
# Admin admin@iitr.ac.in
SEED_ADMIN_PASSWORD=Admin@1234
# Delivery partner delivery@iitr.ac.in
SEED_DELIVERY_PASSWORD=Delivery@1234
