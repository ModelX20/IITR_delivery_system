# Copy this file to .env and adjust as needed.

PORT=4000
NODE_ENV=development

# Postgres (matches both `npm run db` and docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iitr_delivery
# Separate database used by `npm test` (wiped on every test run)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iitr_delivery_test

# Use a long random string in real deployments, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Passwords for the seeded demo accounts (used only by `npx prisma db seed`)
# Students test@iitr.ac.in and riya@iitr.ac.in
SEED_TEST_PASSWORD=Test@1234
# Admin admin@iitr.ac.in
SEED_ADMIN_PASSWORD=Admin@1234
# Delivery partner delivery@iitr.ac.in
SEED_DELIVERY_PASSWORD=Delivery@1234

# ---------- Google sign-in (optional) ----------
# Create an OAuth client ID (type "Web application") in Google Cloud Console and add
# GOOGLE_CALLBACK_URL as an "Authorized redirect URI". The button is hidden while these are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# ---------- Email (SMTP) ----------
# Sign-up verification codes and notifications are sent from here.
# Leave SMTP_HOST empty in development to use a free Ethereal test inbox: emails are not delivered,
# and a preview link for each one (including sign-up codes) is printed in the server console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=<the Gmail address>,
#        SMTP_PASS=<a 16-character Google "app password", never your normal password>. Never commit real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=IITR Delivery <no-reply@iitr-delivery.local>
